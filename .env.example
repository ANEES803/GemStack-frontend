# Backend API — keep browser on same-origin path (avoids Chrome HTTP / mixed-content issues)
NEXT_PUBLIC_API_BASE_URL=/gemstack-api
# Where Next.js rewrite sends /gemstack-api (local or EC2). Not exposed to the browser.
GEMSTACK_API_PROXY_TARGET=http://127.0.0.1:8000
# Example EC2: GEMSTACK_API_PROXY_TARGET=http://13.60.18.45:8000

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
